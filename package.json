{
  "name": "blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A weblog by Seth Lakowske",
  "scripts": {
    "test": "npm run dump && node --test scripts/catalog.test.mjs scripts/render.test.mjs scripts/site-pages.test.mjs scripts/serve.test.mjs && node scripts/check.mjs dump",
    "check": "node scripts/check.mjs dump",
    "catalog": "node scripts/catalog.mjs --check",
    "catalog:report": "node scripts/catalog.mjs --check --report",
    "dump": "node scripts/dump.mjs",
    "build": "npm run dump",
    "render": "node scripts/render.mjs",
    "watch": "node --watch-path=public --watch-path=templates --watch-path=site.json --watch-path=scripts scripts/dump.mjs",
    "preview": "node scripts/serve.mjs",
    "serve": "npm run dump && npm run preview"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lakowske/blog"
  },
  "keywords": [
    "blog"
  ],
  "author": "Seth Lakowske",
  "license": "All rights reserved"
}
